# ----------------------------------------------------------------------------
# Environment variables for the backend.
#
# This file is loaded by BOTH workflows:
#   1. The non-Docker venv workflow: pydantic-settings reads `./backend/.env`
#      because `backend/app/core/config.py` sets `env_file = ".env"` and the
#      dev process runs from the `backend/` directory.
#   2. The Docker Compose workflow: `docker-compose.yml` declares
#      `env_file: ./backend/.env` on the backend service, and inside the
#      container CWD is `/app` (which is the bind-mounted `./backend` dir),
#      so pydantic-settings also finds the same `.env` file.
#
# To use: copy to `backend/.env` and edit values.
#   cp backend/.env.example backend/.env
#
# Comments starting with `#` are ignored. Inline comments on value lines are
# NOT supported by the env parser — put comments on their own lines.
# ----------------------------------------------------------------------------

# JWT signing key. Override for anything that isn't local dev.
# DEV ONLY — never reuse in a deployed environment.
SECRET_KEY=dev-only-do-not-use-in-production

# Database URL. The default below matches `backend/app/core/config.py` and
# resolves to `backend/scheduler.db` on the host in both workflows. Docker
# Compose does NOT override this; the app's default is authoritative.
DATABASE_URL=sqlite+aiosqlite:///./scheduler.db

# Controls the entrypoint's auto-seed gate (Docker workflow only; the
# non-Docker workflow seeds manually via `python backend/scripts/seed_data.py`).
# Set to 0 to skip the check entirely even on an empty DB.
SEED_ON_EMPTY=1

# ─── Moonshot (Kimi) — used by /api/v1/agent/chat ───
# Get a key at https://platform.moonshot.ai/. The agent endpoint
# returns 503 until this is set.
MOONSHOT_API_KEY=
# International endpoint by default; switch to the .cn domain if needed.
MOONSHOT_BASE=https://api.moonshot.ai/v1
# kimi-k2.5 is the reasoning + tool-calling model used in this app.
MOONSHOT_MODEL=kimi-k2.5
